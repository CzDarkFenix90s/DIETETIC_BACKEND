{
	"info": {
		"_postman_id": "dietetic-api-coll",
		"name": "Dietetic App API",
		"description": "Colección completa de endpoints para la App Dietética",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin1234\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/auth/login/", "host": ["{{base_url}}"], "path": ["auth", "login", ""] }
					}
				},
				{
					"name": "Registro",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"nuevo_usuario\",\n    \"email\": \"test@email.com\",\n    \"password\": \"Clave1234*\",\n    \"password2\": \"Clave1234*\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/auth/register/", "host": ["{{base_url}}"], "path": ["auth", "register", ""] }
					}
				}
			]
		},
		{
			"name": "Planes Nutricionales",
			"item": [
				{
					"name": "Listar Planes",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{base_url}}/planes/", "host": ["{{base_url}}"], "path": ["planes", ""] }
					}
				}
			]
		},
		{
			"name": "Pacientes",
			"item": [
				{
					"name": "Listar Pacientes",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": { "raw": "{{base_url}}/pacientes/", "host": ["{{base_url}}"], "path": ["pacientes", ""] }
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": { "type": "text/javascript", "exec": [""] }
		}
	],
	"variable": [
		{ "key": "base_url", "value": "https://paz-dietetica.uaeftt-ute.site/api" },
		{ "key": "token", "value": "TU_TOKEN_AQUI" }
	]
}